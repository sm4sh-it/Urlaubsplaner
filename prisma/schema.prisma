generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Profile {
  id                       String   @id @default(uuid())
  name                     String
  color                    String
  annualLeave              Float
  remainingLeave           Float
  additionalLeave          Float
  remainingLeaveExpiryDate String
  stateCode                String
  startYear                Int      @default(2026)
  workingDays              String   @default("1,2,3,4,5")
  
  entries                  Entry[]
  overrides                ProfileYearOverride[]
  trips                    Trip[]   @relation("ProfileTrips")
  budgetParticipants       BudgetParticipant[]
  
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Trip {
  id                   String    @id @default(cuid())
  title                String
  startDate            String    // YYYY-MM-DD
  endDate              String    // YYYY-MM-DD
  duration             Int
  
  profiles             Profile[] @relation("ProfileTrips")
  externalParticipants String?
  
  type                 String
  status               String
  
  location             String?
  country              String?
  travelType           String?
  transport            String?
  notes                String?
  
  budget               Float?
  cost                 Float?
  
  isHalfDay            Boolean   @default(false)
  halfDayType          String?   // "VORMITTAG" | "NACHMITTAG"
  
  budgetRel            TripBudget? @relation("TripToBudget")
  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model ProfileYearOverride {
  id               String   @id @default(uuid())
  year             Int
  annualLeave      Float?   
  additionalLeave  Float?   
  remainingLeave   Float?   

  profileId        String
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, year])
}

model Entry {
  id        String   @id @default(uuid())
  date      String
  type      String
  
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([date, profileId])
}

model HolidayCache {
  id        String   @id @default(cuid())
  date      String
  name      String
  stateCode String
  year      Int

  @@unique([date, stateCode])
}

model VacationCache {
  id        String   @id @default(cuid())
  startDate String
  endDate   String
  name      String
  stateCode String
  year      Int
}

model TripBudget {
  id           String              @id @default(cuid())
  name         String
  currency     String              @default("EUR")
  totalBudget  Float?              // Geplantes Ausgabenlimit (optional)
  startDate    String?             // YYYY-MM-DD
  endDate      String?             // YYYY-MM-DD
  
  tripId       String?             @unique
  trip         Trip?               @relation("TripToBudget", fields: [tripId], references: [id], onDelete: SetNull)
  
  participants BudgetParticipant[]
  expenses     BudgetExpense[]
  categories   BudgetCategory[]
  
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model BudgetParticipant {
  id           String          @id @default(cuid())
  budgetId     String
  budget       TripBudget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  
  profileId    String?         // null bei externen Gästen
  profile      Profile?        @relation(fields: [profileId], references: [id], onDelete: SetNull)
  
  name         String
  color        String?
  
  splits       ExpenseSplit[]
  paidExpenses BudgetExpense[]
}

model BudgetCategory {
  id        String          @id @default(cuid())
  budgetId  String?         // null = Standardkategorie, sonst reisespezifisch
  budget    TripBudget?     @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  name      String
  icon      String?         // z. B. 'building', 'plane', 'utensils', 'ticket', 'tag'
  color     String?         // Hex-Farbcode
  expenses  BudgetExpense[]
}

model BudgetExpense {
  id          String              @id @default(cuid())
  budgetId    String
  budget      TripBudget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  
  title       String
  amount      Float
  date        String              // YYYY-MM-DD
  notes       String?
  
  categoryId  String?
  category    BudgetCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  payerId     String
  payer       BudgetParticipant   @relation(fields: [payerId], references: [id], onDelete: Cascade)
  
  splits      ExpenseSplit[]
  createdAt   DateTime            @default(now())
}

model ExpenseSplit {
  id            String            @id @default(cuid())
  expenseId     String
  expense       BudgetExpense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  
  participantId String
  participant   BudgetParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  
  amount        Float             // Exakter Anteil dieser Person
}
